/* ============================================================
   Lilop Admin — pages/productos.js
   Gestión de productos del catálogo ecommerce.
   Consume la API REST. No usa AdminStore.
   ============================================================ */
'use strict';

const session = window.AdminAuth.guard();
if (!session) throw new Error('No auth');
window.AdminLayout.init('Productos');

const api = window.AdminApi;
let allProductos = [];
let filtered     = [];
let currentPage  = 1;
const PER_PAGE   = 12;
let editingId    = null;

let CATEGORIAS = {};
api.get('/maestros/categorias').then(cats => {
  cats.forEach(c => { CATEGORIAS[c.slug] = c.nombre; });
}).catch(() => {});

const TAMANIOS = ['Unico','Sencillo','Semidoble','Doble','Queen','King'];

function formatPrice(n) {
  return new Intl.NumberFormat('es-CO', { style:'currency', currency:'COP', minimumFractionDigits:0 }).format(n || 0);
}

/* ─── RENDER GRID ─────────────────────────────────────────── */
function renderGrid() {
  const grid  = document.getElementById('productosGrid');
  const start = (currentPage - 1) * PER_PAGE;
  const page  = filtered.slice(start, start + PER_PAGE);

  if (!page.length) {
    grid.innerHTML = `
      <div class="empty-state" style="grid-column:1/-1;">
        <div class="empty-state__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg></div>
        <p class="empty-state__title">Sin productos</p>
        <p class="empty-state__desc">Agrega tu primer producto al catálogo</p>
      </div>`;
    return;
  }

  grid.innerHTML = page.map(p => {
    const precios   = p.precios || [];
    const precioMin = precios.length ? Math.min(...precios.map(x => parseFloat(x.precio))) : 0;
    const disenos   = (p.disenos || []).filter(d => d.imagen);
    const catLabel  = (p.categorias || []).map(c => c.nombre).join(', ') || '—';
    const carId     = 'car-' + p.id;
    return `
    <div class="admin-panel d-flex flex-col">
      <div class="pos-relative" style="height:160px;background:var(--color-fog);border-radius:var(--r-lg) var(--r-lg) 0 0;overflow:hidden">
        ${disenos.length ? `
          <div id="${carId}" style="display:flex;width:100%;height:100%;transition:transform 0.3s ease">
            ${disenos.map(d => `
              <div style="min-width:100%;height:100%;flex-shrink:0;cursor:zoom-in" data-lightbox="https://api.lilop.store${d.imagen}">
                <img src="https://api.lilop.store${d.imagen}" style="width:100%;height:100%;object-fit:cover;" alt="${d.nombre}" loading="lazy"/>
              </div>`).join('')}
          </div>
          ${disenos.length > 1 ? `
          <button onclick="(function(el,dir){var items=el.querySelectorAll('[data-lightbox]').length;var cur=parseInt(el.dataset.cur||0);cur=(cur+dir+items)%items;el.querySelector('div[style*=flex]').style.transform='translateX(-'+cur*100+'%)';el.dataset.cur=cur})(this.closest('.pos-relative'),${-1})" style="position:absolute;left:6px;top:50%;transform:translateY(-50%);width:28px;height:28px;border-radius:50%;background:rgba(0,0,0,0.5);border:none;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button onclick="(function(el,dir){var items=el.querySelectorAll('[data-lightbox]').length;var cur=parseInt(el.dataset.cur||0);cur=(cur+dir+items)%items;el.querySelector('div[style*=flex]').style.transform='translateX(-'+cur*100+'%)';el.dataset.cur=cur})(this.closest('.pos-relative'),${1})" style="position:absolute;right:6px;top:50%;transform:translateY(-50%);width:28px;height:28px;border-radius:50%;background:rgba(0,0,0,0.5);border:none;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14"><polyline points="9 18 15 12 9 6"/></svg>
          </button>` : ''}
        ` : `<div class="d-flex items-center justify-center" style="width:100%;height:100%"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-lilac)" stroke-width="1.5"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg></div>`}
        <span class="pos-absolute" style="top:10px;right:10px">
          <span class="status-badge ${p.activo ? 'badge--success' : 'badge--inactive'}">${p.activo ? 'Activo' : 'Inactivo'}</span>
          ${p.featured ? '<span class="status-badge badge--warning" style="margin-left:4px">Destacado</span>' : ''}
        </span>
      </div>
      <div class="p-5 flex-1 d-flex flex-col gap-2">
        <p class="text-xs font-semibold uppercase text-violet" style="letter-spacing:0.1em">${catLabel}</p>
        <h3 class="font-display text-base font-semibold" style="line-height:var(--leading-snug)">${p.nombre}</h3>
        ${p.descripcion_corta ? `<p class="text-xs text-muted" style="line-height:var(--leading-snug)">${p.descripcion_corta}</p>` : ''}
        <div class="d-flex items-center justify-between" style="margin-top:auto;padding-top:var(--s-3);border-top:1px solid var(--color-border)">
          <span class="font-display text-lg font-bold text-violet">${precioMin ? formatPrice(precioMin) : '—'}</span>
          <span class="text-xs text-muted">${precios.length} talla${precios.length !== 1 ? 's' : ''}</span>
        </div>
      </div>
      <div class="d-flex gap-2" style="padding:0 var(--s-5) var(--s-5)">
        <button class="btn btn--outline btn--sm flex-1" data-action="edit" data-id="${p.id}">Editar</button>
        <button class="btn btn--ghost btn--sm btn--icon" data-action="toggle" data-id="${p.id}" title="${p.activo ? 'Desactivar' : 'Activar'}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">${p.activo
            ? '<path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24M1 1l22 22"/>'
            : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>'}
          </svg>
        </button>
        <button class="btn btn--danger btn--sm btn--icon" data-action="delete" data-id="${p.id}" data-nombre="${p.nombre}" title="Eliminar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
        </button>
      </div>
    </div>`;
  }).join('');

  grid.querySelectorAll('[data-action="edit"]').forEach(btn =>
    btn.addEventListener('click', () => openModal(btn.dataset.id))
  );
  grid.querySelectorAll('[data-action="toggle"]').forEach(btn =>
    btn.addEventListener('click', () => toggleActivo(btn.dataset.id))
  );
  grid.querySelectorAll('[data-action="delete"]').forEach(btn =>
    btn.addEventListener('click', () => confirmDelete(btn.dataset.id, btn.dataset.nombre))
  );
}

/* ─── PAGINACIÓN ──────────────────────────────────────────── */
function renderPagination() {
  const total = Math.ceil(filtered.length / PER_PAGE);
  const el    = document.getElementById('productosPagination');
  if (!el) return;
  const start = (currentPage - 1) * PER_PAGE + 1;
  const end   = Math.min(currentPage * PER_PAGE, filtered.length);
  el.innerHTML = `
    <span>${start}–${end} de ${filtered.length} productos</span>
    <div class="pagination__btns">
      <button class="pagination__btn" ${currentPage===1?'disabled':''} id="prevP"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg></button>
      ${Array.from({length:total},(_,i)=>`<button class="pagination__btn ${i+1===currentPage?'is-active':''}" data-page="${i+1}">${i+1}</button>`).join('')}
      <button class="pagination__btn" ${currentPage===total?'disabled':''} id="nextP"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></button>
    </div>`;
  document.getElementById('prevP')?.addEventListener('click', ()=>{ currentPage--; renderGrid(); renderPagination(); });
  document.getElementById('nextP')?.addEventListener('click', ()=>{ currentPage++; renderGrid(); renderPagination(); });
  el.querySelectorAll('[data-page]').forEach(b=>b.addEventListener('click',()=>{ currentPage=parseInt(b.dataset.page); renderGrid(); renderPagination(); }));
}

/* ─── MODAL ───────────────────────────────────────────────── */
async function openModal(id) {
  const p = id ? allProductos.find(x => x.id === id) : null;
  editingId = id || null;
  document.getElementById('modalProductoTitle').textContent = p ? 'Editar producto' : 'Nuevo producto';

  const preciosMap = {};
  (p?.precios || []).forEach(pr => { preciosMap[pr.tamanio] = pr.precio; });

  document.getElementById('modalProductoBody').innerHTML = `
    <div class="form-row">
      <div class="form-group">
        <label class="form-label form-label--required">Nombre</label>
        <input class="form-input" id="pNombre" value="${p?.nombre || ''}"/>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">Estado</label>
        <select class="form-input" id="pActivo">
          <option value="true"  ${(!p || p.activo) ?'selected':''}>Activo</option>
          <option value="false" ${p && !p.activo   ?'selected':''}>Inactivo</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Destacado</label>
        <select class="form-input" id="pFeatured">
          <option value="true"  ${p?.featured?'selected':''}>Sí</option>
          <option value="false" ${!p?.featured?'selected':''}>No</option>
        </select>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">Badge</label>
        <input class="form-input" id="pBadge" placeholder="Ej: Más vendido" value="${p?.badge || ''}"/>
      </div>
      <div class="form-group">
        <label class="form-label">Tipo badge</label>
        <select class="form-input" id="pBadgeTipo">
          <option value="">Ninguno</option>
          <option value="featured"  ${p?.badge_tipo==='featured' ?'selected':''}>Destacado</option>
          <option value="new"       ${p?.badge_tipo==='new'      ?'selected':''}>Nuevo</option>
          <option value="sale"      ${p?.badge_tipo==='sale'     ?'selected':''}>Oferta</option>
          <option value="bestseller"${p?.badge_tipo==='bestseller'?'selected':''}>Más vendido</option>
        </select>
      </div>
    </div>
    <div class="form-group">
      <label class="form-label">Descripción corta</label>
      <textarea class="form-input" id="pDescCorta" rows="2">${p?.descripcion_corta || ''}</textarea>
    </div>
    <div class="form-group">
      <label class="form-label">Descripción completa</label>
      <textarea class="form-input" id="pDesc" rows="4">${p?.descripcion || ''}</textarea>
    </div>
    <div class="form-group">
      <label class="form-label">Materiales <span class="text-muted text-xs">(uno por línea)</span></label>
      <textarea class="form-input" id="pMateriales" rows="3">${(p?.materiales || []).join('\n')}</textarea>
    </div>
    <div class="form-group">
      <label class="form-label">Cuidados <span class="text-muted text-xs">(uno por línea)</span></label>
      <textarea class="form-input" id="pCuidados" rows="3">${(p?.cuidados || []).join('\n')}</textarea>
    </div>
    <div class="form-group">
      <label class="form-label">Tags <span class="text-muted text-xs">(separados por coma)</span></label>
      <input class="form-input" id="pTags" value="${(p?.tags || []).join(', ')}" placeholder="algodón, premium, suave"/>
    </div>
    <div class="form-group">
      <label class="form-label">Precio original (COP) <span class="text-muted text-xs">(opcional, para mostrar tachado)</span></label>
      <input class="form-input" type="number" id="pPrecioOriginal" value="${p?.precio_original || ''}"/>
    </div>
    <div class="form-group">
      <label class="form-label">Atributos aplicables <span class="text-muted text-xs">(sobreprecio se suma automáticamente)</span></label>
      <div class="d-flex flex-col gap-2 p-3 radius-md" id="pAtributosWrap" style="background:var(--color-fog)">
        <p class="text-xs text-muted">Cargando atributos…</p>
      </div>
    </div>
    <div class="form-group">
      <label class="form-label">Categorías</label>
      <div class="d-flex flex-col gap-2 p-3 radius-md" id="pCategoriasWrap" style="background:var(--color-fog)">
        <p class="text-xs text-muted">Cargando categorías…</p>
      </div>
    </div>
    <div class="form-group">
      <label class="form-label font-semibold">Precios por tamaño (COP)</label>
      <div class="d-grid gap-2" style="grid-template-columns:repeat(auto-fill,minmax(150px,1fr))">
        ${TAMANIOS.map(t => `
          <div>
            <label class="form-label text-xs">${t}</label>
            <input class="form-input text-xs" type="number" min="0" id="precio-${t}" value="${preciosMap[t] || ''}" placeholder="—"/>
          </div>`).join('')}
      </div>
    </div>
  `;

  try {
    const atributos = await api.get('/atributos');
    const asignados = new Set((p?.atributos || []).map(a => a.id));
    document.getElementById('pAtributosWrap').innerHTML = atributos.length ? atributos.map(a => `
      <label class="d-flex items-center gap-2 text-sm">
        <input type="checkbox" class="atributo-check" value="${a.id}" ${asignados.has(a.id) ? 'checked' : ''}/>
        ${a.nombre} <span class="text-xs text-muted">(+${new Intl.NumberFormat('es-CO',{style:'currency',currency:'COP',minimumFractionDigits:0}).format(a.sobreprecio)})</span>
      </label>`).join('') : '<p class="text-xs text-muted">No hay atributos configurados</p>';
  } catch (err) {
    document.getElementById('pAtributosWrap').innerHTML = '<p class="text-xs text-muted">Error al cargar atributos</p>';
  }

  try {
    const categorias = await api.get('/maestros/categorias');
    const catAsignadas = new Set((p?.categorias || []).map(c => c.id));
    document.getElementById('pCategoriasWrap').innerHTML = categorias.length ? categorias.map(c => `
      <label class="d-flex items-center gap-2 text-sm">
        <input type="checkbox" class="cat-check" value="${c.id}" ${catAsignadas.has(c.id) ? 'checked' : ''}/>
        ${c.nombre}
      </label>`).join('') : '<p class="text-xs text-muted">No hay categorías configuradas</p>';
  } catch (err) {
    document.getElementById('pCategoriasWrap').innerHTML = '<p class="text-xs text-muted">Error al cargar categorías</p>';
  }

  window.AdminModal.open('modalProducto');
}

/* ─── GUARDAR ─────────────────────────────────────────────── */
document.getElementById('btnGuardarProducto')?.addEventListener('click', async () => {
  const nombre = document.getElementById('pNombre')?.value.trim();
  if (!nombre) { window.AdminToast?.error('Campo requerido', 'El nombre es obligatorio'); return; }

  const categoria_ids = [...document.querySelectorAll('.cat-check:checked')].map(c => parseInt(c.value));
  const atributo_ids = [...document.querySelectorAll('.atributo-check:checked')].map(c => parseInt(c.value));
  const data = {
    descripcion:       document.getElementById('pDesc')?.value.trim()      || null,
    descripcion_corta: document.getElementById('pDescCorta')?.value.trim() || null,
    materiales: document.getElementById('pMateriales')?.value.split('\n').map(s=>s.trim()).filter(Boolean),
    cuidados:   document.getElementById('pCuidados')?.value.split('\n').map(s=>s.trim()).filter(Boolean),
    tags:       document.getElementById('pTags')?.value.split(',').map(s=>s.trim()).filter(Boolean),
    featured:    document.getElementById('pFeatured')?.value === 'true',
    badge:       document.getElementById('pBadge')?.value.trim()     || null,
    badge_tipo:  document.getElementById('pBadgeTipo')?.value        || null,
    precio_original: parseFloat(document.getElementById('pPrecioOriginal')?.value) || null,
    categoria_ids,
  };

  try {
    let catId = editingId;
    if (editingId) {
      await api.put(`/catalogo/${editingId}`, data);
      window.AdminToast?.success('Producto actualizado');
    } else {
      const nuevo = await api.post('/catalogo', { nombre });
      catId = nuevo.id;
      await api.put(`/catalogo/${catId}`, data);
      // Actualizar activo si viene de crear
      if (document.getElementById('pActivo')?.value === 'false') {
        await api.patch(`/catalogo/${catId}/toggle`, {});
      }
      window.AdminToast?.success('Producto creado');
    }

    // Guardar precios por tamaño
    for (const t of TAMANIOS) {
      const val = parseFloat(document.getElementById(`precio-${t}`)?.value);
      if (val > 0) {
        await api.post(`/catalogo/${catId}/precios`, { tamanio: t, precio: val });
      }
    }

    await api.put(`/atributos/producto/${catId}`, { atributo_ids });
    window.AdminModal.close('modalProducto');
    await loadData();
  } catch (err) {
    window.AdminToast?.error('Error', err.message);
  }
});

/* ─── TOGGLE ACTIVO ───────────────────────────────────────── */
async function toggleActivo(id) {
  try {
    await api.patch(`/catalogo/${id}/toggle`, {});
    await loadData();
    window.AdminToast?.success('Estado actualizado');
  } catch (err) {
    window.AdminToast?.error('Error', err.message);
  }
}

/* ─── ELIMINAR ────────────────────────────────────────────── */
function confirmDelete(id, nombre) {
  window.AdminConfirm.show(
    `¿Eliminar <strong>${nombre}</strong>? Esta acción no se puede deshacer.`,
    async () => {
      try {
        await api.delete(`/catalogo/${id}`);
        window.AdminToast?.success('Producto eliminado');
        await loadData();
      } catch (err) {
        window.AdminToast?.error('Error', err.message);
      }
    }
  );
}

/* ─── FILTROS ─────────────────────────────────────────────── */
function applyFilters() {
  const q   = document.getElementById('searchProductos')?.value.toLowerCase().trim() || '';
  const cat = document.getElementById('filterCategoria')?.value || '';
  const est = document.getElementById('filterEstadoP')?.value || '';
  filtered = allProductos.filter(p =>
    (!q   || p.nombre.toLowerCase().includes(q)) &&
    (!cat || (p.categorias || []).some(c => c.slug === cat)) &&
    (!est || (est === 'active' ? p.activo : !p.activo))
  );
  currentPage = 1;
  renderGrid();
  renderPagination();
  document.getElementById('productosCount').textContent =
    `${filtered.length} producto${filtered.length !== 1 ? 's' : ''}`;
}

/* ─── CARGAR DATOS ────────────────────────────────────────── */
async function loadData() {
  try {
    allProductos = await api.get('/catalogo');
    applyFilters();
  } catch (err) {
    window.AdminToast?.error('Error', 'No se pudieron cargar los productos');
  }
}

/* ─── INIT ────────────────────────────────────────────────── */
document.addEventListener('DOMContentLoaded', () => {
  window.AdminAuth.populateUserInfo(session);
  loadData();

  api.get('/maestros/categorias').then(cats => {
    const sel = document.getElementById('filterCategoria');
    if (sel) sel.innerHTML = '<option value="">Todas las categorías</option>' +
      cats.map(c => `<option value="${c.slug}">${c.nombre}</option>`).join('');
  }).catch(() => {});

  window.AdminLightbox.init();
  document.addEventListener('click', e => {
    const el = e.target.closest('[data-lightbox]');
    if (el) window.AdminLightbox.open(el.dataset.lightbox);
  });
  let t;
  document.getElementById('searchProductos')?.addEventListener('input', () => { clearTimeout(t); t = setTimeout(applyFilters, 300); });
  document.getElementById('filterCategoria')?.addEventListener('change', applyFilters);
  document.getElementById('filterEstadoP')?.addEventListener('change', applyFilters);
  document.getElementById('btnNuevoProducto')?.addEventListener('click', () => openModal(null));
});
