/* ============================================================
   Lilop — pages/producto.css
   Estilos exclusivos de la página de producto (producto.html).
   Secciones: galería, info, variantes, acordeón,
   productos relacionados.
   ============================================================ */

/* ─── BREADCRUMB ──────────────────────────────────────────── */
.product-breadcrumb {
  padding-block: var(--s-5);
  border-bottom: 1px solid var(--color-border);
  background: var(--color-white);
}

.product-breadcrumb__inner {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  flex-wrap: wrap;
}

.product-breadcrumb__inner a {
  color: var(--color-text-muted);
  text-decoration: none;
  transition: color var(--duration-fast) var(--ease);
}

.product-breadcrumb__inner a:hover {
  color: var(--color-violet);
}

.product-breadcrumb__inner span {
  color: var(--color-text-light);
}

.product-breadcrumb__current {
  color: var(--color-text);
  font-weight: var(--weight-medium);
}

/* ─── LAYOUT PRINCIPAL DEL PRODUCTO ──────────────────────── */
.product-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-16);
  align-items: flex-start;
  padding-block: var(--s-10);
}

/* ─── GALERÍA DE IMÁGENES ─────────────────────────────────── */
.product-gallery {
  position: sticky;
  top: calc(var(--topbar-h) + var(--navbar-h) + var(--s-6));
  display: flex;
  flex-direction: column;
  gap: var(--s-4);
}

.product-gallery__main {
  width: 100%;
  aspect-ratio: 1;
  border-radius: var(--r-2xl);
  overflow: hidden;
  background: var(--color-fog);
  position: relative;
  cursor: zoom-in;
}

.product-gallery__main-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s var(--ease);
}

.product-gallery__main:hover .product-gallery__main-img {
  transform: scale(1.04);
}

/* Badge sobre la imagen principal */
.product-gallery__badge {
  position: absolute;
  top: var(--s-4);
  left: var(--s-4);
  z-index: 1;
}

/* Thumbnails */
.product-gallery__thumbs {
  display: flex;
  gap: var(--s-3);
  flex-wrap: wrap;
}

.product-gallery__thumb {
  width: 80px;
  height: 80px;
  border-radius: var(--r-md);
  overflow: hidden;
  cursor: pointer;
  border: 2px solid transparent;
  background: var(--color-fog);
  transition:
    border-color var(--duration-base) var(--ease),
    transform var(--duration-fast) var(--ease);
  flex-shrink: 0;
}

.product-gallery__thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s var(--ease);
}

.product-gallery__thumb:hover {
  transform: translateY(-2px);
}

.product-gallery__thumb:hover img {
  transform: scale(1.05);
}

.product-gallery__thumb.is-active {
  border-color: var(--color-violet);
  box-shadow: 0 0 0 2px var(--color-soft);
}

.product-gallery__thumb:focus-visible {
  outline: none;
  border-color: var(--color-violet);
  box-shadow: var(--shadow-focus);
}

/* ─── INFO DEL PRODUCTO ───────────────────────────────────── */
.product-info {
  display: flex;
  flex-direction: column;
  gap: var(--s-6);
}

.product-info__category {
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-violet);
}

.product-info__title {
  font-family: var(--font-display);
  font-size: var(--text-3xl);
  font-weight: var(--weight-semibold);
  line-height: var(--leading-snug);
  color: var(--color-text);
  letter-spacing: -0.01em;
}

/* Rating */
.product-info__rating {
  display: flex;
  align-items: center;
  gap: var(--s-3);
  flex-wrap: wrap;
}

.product-info__stars {
  display: flex;
  gap: 2px;
}

.product-info__star {
  width: 16px;
  height: 16px;
  color: #f59e0b;
  fill: #f59e0b;
}

.product-info__star--empty {
  color: var(--color-border);
  fill: var(--color-border);
}

.product-info__rating-score {
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--color-text);
}

.product-info__rating-count {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}

/* Precio */
.product-info__price-wrap {
  display: flex;
  align-items: baseline;
  gap: var(--s-3);
  flex-wrap: wrap;
}

.product-info__price {
  font-family: var(--font-display);
  font-size: var(--text-4xl);
  font-weight: var(--weight-bold);
  background: var(--grad-primary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
}

.product-info__price-original {
  font-size: var(--text-xl);
  color: var(--color-text-light);
  text-decoration: line-through;
  font-weight: var(--weight-regular);
}

.product-info__price-save {
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--color-success);
  background: var(--color-success-bg);
  padding: 3px 10px;
  border-radius: var(--r-pill);
}

/* Descripción corta */
.product-info__short-desc {
  font-size: var(--text-base);
  line-height: var(--leading-relaxed);
  color: var(--color-text-muted);
  font-weight: var(--weight-light);
  padding-bottom: var(--s-4);
  border-bottom: 1px solid var(--color-border);
}

/* ─── SELECTORES DE VARIANTES ─────────────────────────────── */
.product-variants {
  display: flex;
  flex-direction: column;
  gap: var(--s-5);
}

.variant-group {
  display: flex;
  flex-direction: column;
  gap: var(--s-3);
}

.variant-group__label {
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--color-text);
  display: flex;
  align-items: center;
  gap: var(--s-2);
}

.variant-group__selected {
  font-weight: var(--weight-regular);
  color: var(--color-violet);
}

.variant-group__options {
  display: flex;
  gap: var(--s-2);
  flex-wrap: wrap;
}

.variant-btn {
  padding: 8px 18px;
  border: 1.5px solid var(--color-border);
  border-radius: var(--r-pill);
  font-family: var(--font-body);
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  color: var(--color-text-muted);
  background: var(--color-white);
  cursor: pointer;
  transition:
    border-color var(--duration-fast) var(--ease),
    background var(--duration-fast) var(--ease),
    color var(--duration-fast) var(--ease),
    transform var(--duration-fast) var(--ease);
  user-select: none;
}

.variant-btn:hover {
  border-color: var(--color-lavender);
  color: var(--color-violet);
  background: var(--color-fog);
}

.variant-btn.is-selected {
  border-color: var(--color-violet);
  background: var(--color-soft);
  color: var(--color-violet);
  font-weight: var(--weight-semibold);
}

.variant-btn:focus-visible {
  outline: none;
  box-shadow: var(--shadow-focus);
}

/* Error: no seleccionó variante */
.variant-group.has-error .variant-group__label {
  color: var(--color-error);
}

.variant-group.has-error .variant-btn {
  border-color: rgba(239, 68, 68, 0.3);
}

.variant-error-msg {
  font-size: var(--text-xs);
  color: var(--color-error);
  display: none;
  align-items: center;
  gap: var(--s-1);
}

.variant-group.has-error .variant-error-msg {
  display: flex;
}

/* ─── ATRIBUTOS (switches con sobreprecio) ────────────────── */
.product-attributes {
  display: flex;
  flex-direction: column;
  gap: var(--s-3);
}

.attribute-switch {
  display: flex;
  align-items: center;
  gap: var(--s-3);
  cursor: pointer;
  user-select: none;
  width: fit-content;
}

.attribute-switch__input {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
}

.attribute-switch__track {
  position: relative;
  width: 40px;
  height: 24px;
  flex-shrink: 0;
  border-radius: var(--r-pill);
  background: var(--color-border);
  transition: background var(--duration-fast) var(--ease);
}

.attribute-switch__track::before {
  content: '';
  position: absolute;
  top: 3px;
  left: 3px;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--color-white);
  box-shadow: var(--shadow-xs);
  transition: transform var(--duration-fast) var(--ease);
}

.attribute-switch__input:checked + .attribute-switch__track {
  background: var(--grad-primary);
}

.attribute-switch__input:checked + .attribute-switch__track::before {
  transform: translateX(16px);
}

.attribute-switch__input:focus-visible + .attribute-switch__track {
  box-shadow: var(--shadow-focus);
}

.attribute-switch__label {
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  color: var(--color-text);
}

.attribute-switch__extra {
  font-weight: var(--weight-regular);
  color: var(--color-violet);
}

/* ─── ACCIONES DE COMPRA ──────────────────────────────────── */
.product-actions {
  display: flex;
  flex-direction: column;
  gap: var(--s-3);
  padding-top: var(--s-2);
}

.product-actions__add {
  width: 100%;
  padding: 16px;
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  border-radius: var(--r-pill);
  background: var(--grad-primary);
  color: var(--color-white);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--s-3);
  transition:
    filter var(--duration-fast) var(--ease),
    transform var(--duration-fast) var(--ease),
    box-shadow var(--duration-base) var(--ease);
  box-shadow: var(--shadow-sm);
}

.product-actions__add:hover {
  filter: brightness(1.08);
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.product-actions__add:active {
  transform: translateY(0);
  filter: brightness(0.96);
}

.product-actions__add:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

.product-actions__add svg {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
}

.product-actions__whatsapp {
  width: 100%;
  padding: 14px;
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  border-radius: var(--r-pill);
  background: #25d366;
  color: var(--color-white);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--s-3);
  text-decoration: none;
  transition:
    filter var(--duration-fast) var(--ease),
    transform var(--duration-fast) var(--ease);
}

.product-actions__whatsapp:hover {
  filter: brightness(1.06);
  transform: translateY(-2px);
}

.product-actions__whatsapp svg {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}

/* Notas de confianza */
.product-trust {
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
  padding: var(--s-4);
  background: var(--color-fog);
  border-radius: var(--r-lg);
  border: 1px solid var(--color-border);
}

.product-trust__item {
  display: flex;
  align-items: center;
  gap: var(--s-3);
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  font-weight: var(--weight-medium);
}

.product-trust__item svg {
  width: 15px;
  height: 15px;
  color: var(--color-violet);
  flex-shrink: 0;
}

/* ─── ACORDEÓN DE DETALLES ────────────────────────────────── */
.product-accordion {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--color-border);
  border-radius: var(--r-xl);
  overflow: hidden;
}

.accordion-item {
  border-bottom: 1px solid var(--color-border);
}

.accordion-item:last-child {
  border-bottom: none;
}

.accordion-item__toggle {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--s-5) var(--s-6);
  font-family: var(--font-body);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--color-text);
  background: var(--color-white);
  border: none;
  cursor: pointer;
  text-align: left;
  transition: background var(--duration-fast) var(--ease);
}

.accordion-item__toggle:hover {
  background: var(--color-fog);
}

.accordion-item__icon {
  width: 18px;
  height: 18px;
  color: var(--color-text-muted);
  transition: transform var(--duration-base) var(--ease);
  flex-shrink: 0;
}

.accordion-item__toggle[aria-expanded="true"] .accordion-item__icon {
  transform: rotate(180deg);
}

.accordion-item__body {
  padding: 0 var(--s-6) var(--s-5);
  background: var(--color-white);
  animation: slide-down 0.25s var(--ease) both;
}

.accordion-item__body.is-hidden {
  display: none;
}

.accordion-item__body p,
.accordion-item__body li {
  font-size: var(--text-sm);
  line-height: var(--leading-relaxed);
  color: var(--color-text-muted);
  font-weight: var(--weight-light);
}

.accordion-item__body ul {
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
  padding-left: var(--s-4);
}

.accordion-item__body li {
  position: relative;
  padding-left: var(--s-4);
}

.accordion-item__body li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--color-lilac);
}

/* ─── PRODUCTOS RELACIONADOS ──────────────────────────────── */
.related-products {
  background: var(--color-fog);
  padding-block: var(--s-16);
}

.related-products__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--s-5);
}

/* ─── SKELETON PRODUCTO ───────────────────────────────────── */
.product-skeleton {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-16);
  padding-block: var(--s-10);
}

.product-skeleton__gallery {
  display: flex;
  flex-direction: column;
  gap: var(--s-4);
}

.product-skeleton__main {
  aspect-ratio: 1;
  border-radius: var(--r-2xl);
}

.product-skeleton__thumbs {
  display: flex;
  gap: var(--s-3);
}

.product-skeleton__thumb {
  width: 80px;
  height: 80px;
  border-radius: var(--r-md);
}

.product-skeleton__info {
  display: flex;
  flex-direction: column;
  gap: var(--s-4);
  padding-top: var(--s-2);
}

.product-skeleton__line {
  border-radius: var(--r-sm);
}

/* ─── RESPONSIVE ──────────────────────────────────────────── */
@media (max-width: 1024px) {
  .product-layout {
    grid-template-columns: 1fr;
    gap: var(--s-8);
  }

  .product-gallery {
    position: static;
  }

  .product-gallery__main {
    aspect-ratio: 4 / 3;
  }

  .related-products__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .product-info__title {
    font-size: var(--text-2xl);
  }

  .product-info__price {
    font-size: var(--text-3xl);
  }

  .product-gallery__thumbs {
    display: none;
  }

  .related-products__grid {
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-3);
  }
}