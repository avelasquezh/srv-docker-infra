/* ============================================================
   Lilop — pages/checkout.js
   Responsabilidad única: lógica del checkout.
   - Redirige a /carrito.html si el carrito está vacío
   - Renderiza resumen lateral con items, subtotal y total
   - Envío gratis automático si supera $200.000
   - Maneja selección visual del método de pago
   - Valida todos los campos requeridos del formulario
   - Muestra errores inline por campo
   - Guarda el pedido en localStorage para gracias.html
   - MercadoPago: ⚠️ PENDIENTE — requiere backend con
     Access Token. Estructura lista para conectar.
   - Método WhatsApp: genera link con resumen del pedido
   - Método Transferencia: muestra instrucciones
   ============================================================ */

'use strict';

const store  = window.LilopStore;
const router = window.LilopRouter;

const FREE_SHIPPING = 200000;
const WA_NUMBER     = '573001234567';

/* ─── REDIRIGIR SI CARRITO VACÍO ──────────────────────────── */
function guardEmptyCart() {
  if (store.isEmpty()) {
    window.LilopToast?.info('Carrito vacío', 'Agrega productos antes de pagar');
    setTimeout(() => router.navigateTo('catalogo.html'), 1500);
    return true;
  }
  return false;
}

/* ─── RENDERIZAR RESUMEN LATERAL ──────────────────────────── */
function renderSummary() {
  const cart          = store.getCart();
  const subtotal      = store.getTotal();
  const freeShipping  = subtotal >= FREE_SHIPPING;

  /* Items */
  const itemsEl = document.getElementById('summaryItems');
  if (itemsEl) {
    itemsEl.innerHTML = cart.map((item) => `
      <div class="checkout-summary__item">
        <div class="checkout-summary__item-img">
          <img
            src="${item.image || '/assets/img/placeholder.jpg'}"
            alt="${item.name}"
            loading="lazy"
            onerror="this.src='/assets/img/placeholder.jpg'"
          />
          <span class="checkout-summary__item-qty" aria-label="${item.quantity} unidades">
            ${item.quantity}
          </span>
        </div>
        <div class="checkout-summary__item-info">
          <p class="checkout-summary__item-name">${item.name}</p>
          ${item.variant
            ? `<p class="checkout-summary__item-variant">${item.variant}</p>`
            : ''}
        </div>
        <span class="checkout-summary__item-price">
          ${store.formatPrice(item.price * item.quantity)}
        </span>
      </div>
    `).join('');
  }

  /* Totales */
  const count      = store.getCount();
  const labelEl    = document.getElementById('summaryItemsLabel');
  const subtotalEl = document.getElementById('summarySubtotal');
  const shippingEl = document.getElementById('summaryShipping');
  const totalEl    = document.getElementById('summaryTotal');

  if (labelEl)    labelEl.textContent    = `Productos (${count})`;
  if (subtotalEl) subtotalEl.textContent = store.formatPrice(subtotal);
  if (totalEl)    totalEl.textContent    = store.formatPrice(subtotal);
  if (shippingEl) shippingEl.textContent = freeShipping ? 'Gratis' : 'Por calcular';
}

/* ─── MÉTODO DE PAGO ──────────────────────────────────────── */
function initPaymentMethods() {
  const methods  = document.querySelectorAll('.payment-method');
  const mpNotice = document.getElementById('mpNotice');

  methods.forEach((label) => {
    const radio = label.querySelector('input[type="radio"]');
    radio?.addEventListener('change', () => {
      /* Quitar is-selected de todos */
      methods.forEach((m) => m.classList.remove('is-selected'));
      /* Agregar al seleccionado */
      label.classList.add('is-selected');
      /* Mostrar/ocultar aviso MP */
      if (mpNotice) {
        mpNotice.style.display = radio.value === 'mercadopago' ? 'flex' : 'none';
      }
    });

    /* Click en el label entero selecciona el radio */
    label.addEventListener('click', (e) => {
      if (e.target === radio) return;
      radio.checked = true;
      radio.dispatchEvent(new Event('change'));
    });
  });
}

/* ─── VALIDACIÓN DEL FORMULARIO ───────────────────────────── */
const REQUIRED_FIELDS = [
  { id: 'firstName',  label: 'Nombre' },
  { id: 'lastName',   label: 'Apellido' },
  { id: 'email',      label: 'Correo electrónico', type: 'email' },
  { id: 'phone',      label: 'Teléfono' },
  { id: 'city',       label: 'Ciudad' },
  { id: 'address',    label: 'Dirección' },
];

function clearFieldError(id) {
  const input   = document.getElementById(id);
  const errMsg  = document.getElementById(`${id}Error`);
  input?.classList.remove('form-input--error');
  if (errMsg) errMsg.remove();
}

function showFieldError(id, message) {
  const input = document.getElementById(id);
  if (!input) return;

  input.classList.add('form-input--error');
  input.focus();

  /* Evitar duplicados */
  const existing = document.getElementById(`${id}Error`);
  if (existing) existing.remove();

  const msg = document.createElement('p');
  msg.className = 'form-error-msg';
  msg.id        = `${id}Error`;
  msg.setAttribute('role', 'alert');
  msg.innerHTML = `
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/>
      <line x1="12" y1="8" x2="12" y2="12"/>
      <line x1="12" y1="16" x2="12.01" y2="16"/>
    </svg>
    ${message}
  `;
  input.parentElement?.appendChild(msg);
}

function validateForm() {
  let valid      = true;
  let firstError = null;

  REQUIRED_FIELDS.forEach(({ id, label, type }) => {
    clearFieldError(id);
    const input = document.getElementById(id);
    if (!input) return;

    const value = input.value.trim();

    if (!value) {
      showFieldError(id, `${label} es obligatorio`);
      if (!firstError) firstError = input;
      valid = false;
      return;
    }

    if (type === 'email') {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(value)) {
        showFieldError(id, 'Ingresa un correo electrónico válido');
        if (!firstError) firstError = input;
        valid = false;
      }
    }

    if (id === 'phone') {
      const digits = value.replace(/\D/g, '');
      if (digits.length < 7) {
        showFieldError(id, 'Ingresa un teléfono válido');
        if (!firstError) firstError = input;
        valid = false;
      }
    }
  });

  if (!valid && firstError) {
    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  return valid;
}

/* ─── RECOPILAR DATOS DEL FORMULARIO ──────────────────────── */
function collectFormData() {
  return {
    firstName:    document.getElementById('firstName')?.value.trim(),
    lastName:     document.getElementById('lastName')?.value.trim(),
    email:        document.getElementById('email')?.value.trim(),
    phone:        document.getElementById('phone')?.value.trim(),
    city:         document.getElementById('city')?.value.trim(),
    department:   document.getElementById('department')?.value.trim(),
    address:      document.getElementById('address')?.value.trim(),
    neighborhood: document.getElementById('neighborhood')?.value.trim(),
    apartment:    document.getElementById('apartment')?.value.trim(),
    notes:        document.getElementById('orderNotes')?.value.trim(),
    paymentMethod: document.querySelector('input[name="paymentMethod"]:checked')?.value || 'mercadopago',
  };
}

/* ─── GUARDAR PEDIDO EN LOCALSTORAGE ──────────────────────── */
function saveOrderToStorage(formData) {
  const order = {
    id:        `ORD-${Date.now()}`,
    date:      new Date().toISOString(),
    customer:  formData,
    items:     store.getCart(),
    subtotal:  store.getTotal(),
    shipping:  store.getTotal() >= FREE_SHIPPING ? 0 : null,
    total:     store.getTotal(),
    status:    'pending',
  };
  try {
    localStorage.setItem('lilop_last_order', JSON.stringify(order));
  } catch (e) {
    console.warn('No se pudo guardar el pedido:', e);
  }
  return order;
}

/* ─── LINK DE WHATSAPP CON RESUMEN ────────────────────────── */
function buildWhatsAppMessage(formData, order) {
  const items = store.getCart()
    .map((i) => `• ${i.name}${i.variant ? ` (${i.variant})` : ''} × ${i.quantity} = ${store.formatPrice(i.price * i.quantity)}`)
    .join('\n');

  const msg = encodeURIComponent(
    `🛍️ *Nuevo pedido Lilop*\n\n` +
    `*Pedido:* ${order.id}\n` +
    `*Cliente:* ${formData.firstName} ${formData.lastName}\n` +
    `*Teléfono:* ${formData.phone}\n` +
    `*Email:* ${formData.email}\n\n` +
    `*Envío a:*\n` +
    `${formData.address}${formData.apartment ? ', ' + formData.apartment : ''}\n` +
    `${formData.neighborhood ? formData.neighborhood + ', ' : ''}${formData.city}` +
    `${formData.department ? ', ' + formData.department : ''}\n\n` +
    `*Productos:*\n${items}\n\n` +
    `*Total:* ${store.formatPrice(order.total)}\n` +
    `*Método de pago:* ${formData.paymentMethod === 'transfer' ? 'Transferencia bancaria' : 'WhatsApp'}\n\n` +
    (formData.notes ? `*Notas:* ${formData.notes}` : '')
  );

  return `https://wa.me/${WA_NUMBER}?text=${msg}`;
}

/* ─── PROCESAR PEDIDO ─────────────────────────────────────── */
async function saveOrderToApi(formData, order) {
  try {
    const res = await fetch('https://api.lilop.store/api/public/pedidos', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ...formData, items: store.getCart() }),
    });
    if (!res.ok) throw new Error(`API respondió ${res.status}`);
  } catch (err) {
    console.error('No se pudo guardar el pedido en el servidor:', err);
    /* No se bloquea el flujo del cliente: el pedido sigue coordinándose por el método elegido */
  }
}

async function processOrder(formData) {
  const btn = document.getElementById('submitOrderBtn');
  btn.classList.add('is-loading');
  btn.disabled = true;

  const order = saveOrderToStorage(formData);
  await saveOrderToApi(formData, order);

  try {
    if (formData.paymentMethod === 'mercadopago') {
      /* ─────────────────────────────────────────────────────
         TODO: INTEGRACIÓN MERCADOPAGO
         ─────────────────────────────────────────────────────
         Cuando tengas el backend, reemplaza este bloque por:

         const response = await fetch('https://tu-api.com/create-preference', {
           method: 'POST',
           headers: { 'Content-Type': 'application/json' },
           body: JSON.stringify({
             items: store.getCart(),
             payer: {
               name:  formData.firstName,
               surname: formData.lastName,
               email: formData.email,
               phone: { number: formData.phone },
             },
             back_urls: {
               success: 'https://lilop.store/gracias.html',
               failure: 'https://lilop.store/carrito.html',
               pending: 'https://lilop.store/gracias.html',
             },
             notification_url: 'https://tu-api.com/mp-webhook',
             external_reference: order.id,
           }),
         });
         const { init_point } = await response.json();
         window.location.href = init_point;  // redirige a MP
         ─────────────────────────────────────────────────────

         Por ahora: simular el flujo y redirigir a gracias.html
      ──────────────────────────────────────────────────── */

      /* Simular delay de red */
      await new Promise((resolve) => setTimeout(resolve, 1200));

      store.clearCart();
      router.navigateTo('gracias.html');

    } else if (formData.paymentMethod === 'whatsapp') {
      /* Coordinar por WhatsApp */
      const waLink = buildWhatsAppMessage(formData, order);
      store.clearCart();
      window.open(waLink, '_blank', 'noopener,noreferrer');
      router.navigateTo('gracias.html');

    } else if (formData.paymentMethod === 'transfer') {
      /* Transferencia bancaria */
      await new Promise((resolve) => setTimeout(resolve, 800));
      store.clearCart();
      router.navigateTo('gracias.html');
    }

  } catch (err) {
    console.error('Lilop Pago: error procesando pedido', err);
    window.LilopToast?.error(
      'Error al procesar',
      'Hubo un error. Por favor intenta de nuevo o contáctanos por WhatsApp.'
    );
    btn.classList.remove('is-loading');
    btn.disabled = false;
  }
}

/* ─── INIT FORMULARIO ─────────────────────────────────────── */
function initForm() {
  /* Limpiar errores al escribir */
  REQUIRED_FIELDS.forEach(({ id }) => {
    document.getElementById(id)?.addEventListener('input', () => clearFieldError(id));
  });

  /* Submit */
  document.getElementById('submitOrderBtn')?.addEventListener('click', () => {
    if (!validateForm()) return;
    const formData = collectFormData();
    processOrder(formData);
  });
}

/* ─── INIT ────────────────────────────────────────────────── */
document.addEventListener('DOMContentLoaded', () => {
  if (guardEmptyCart()) return;
  renderSummary();
  initPaymentMethods();
  initForm();
});