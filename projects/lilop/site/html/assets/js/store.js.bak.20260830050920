/* ============================================================
   Lilop — store.js
   Estado global de la aplicación.
   Responsabilidad única: gestionar el carrito.
   - Única fuente de verdad para items del carrito
   - Persiste en localStorage
   - Emite eventos personalizados para que los componentes
     reaccionen sin acoplamiento directo
   - NUNCA acceder a localStorage desde otro archivo JS
   ============================================================ */

const STORAGE_KEY = 'lilop_cart';

/* ─── EVENTOS PERSONALIZADOS ──────────────────────────────── */
/*
  Eventos que emite el store (escuchar con window.addEventListener):

  'lilop:cart:updated'  → se dispara en cualquier cambio del carrito
    detail: { cart, count, total }

  'lilop:cart:item-added'  → producto agregado
    detail: { item, cart, count, total }

  'lilop:cart:item-removed' → producto eliminado
    detail: { productId, cart, count, total }

  'lilop:cart:cleared' → carrito vaciado
    detail: { cart, count, total }
*/

function emit(name, detail) {
  window.dispatchEvent(new CustomEvent(name, { detail, bubbles: true }));
}

/* ─── LECTURA / ESCRITURA EN LOCALSTORAGE ─────────────────── */
function readCart() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    return raw ? JSON.parse(raw) : [];
  } catch {
    return [];
  }
}

function writeCart(cart) {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
  } catch (e) {
    console.warn('Lilop Store: no se pudo guardar el carrito', e);
  }
}

/* ─── CÁLCULOS ────────────────────────────────────────────── */
function calcTotal(cart) {
  return cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
}

function calcCount(cart) {
  return cart.reduce((sum, item) => sum + item.quantity, 0);
}

function buildSummary(cart) {
  return {
    cart,
    count: calcCount(cart),
    total: calcTotal(cart),
  };
}

/* ─── ACCIONES DEL CARRITO ────────────────────────────────── */

/**
 * Agrega un producto al carrito.
 * Si ya existe con la misma variante, incrementa la cantidad.
 *
 * @param {Object} product
 * @param {number} product.id          - ID único del producto
 * @param {string} product.name        - Nombre del producto
 * @param {number} product.price       - Precio unitario (número)
 * @param {string} product.image       - URL de la imagen principal
 * @param {string} [product.variant]   - Variante seleccionada (ej: "Queen / Blanco")
 * @param {number} [product.quantity]  - Cantidad a agregar (default: 1)
 */
function addToCart(product) {
  const cart = readCart();
  const qty  = product.quantity || 1;

  // Clave única: id + variante
  const key   = `${product.id}__${product.variant || ''}`;
  const index = cart.findIndex(
    i => `${i.id}__${i.variant || ''}` === key
  );

  if (index > -1) {
    cart[index].quantity += qty;
  } else {
    cart.push({
      id:       product.id,
      name:     product.name,
      price:    product.price,
      image:    product.image || '',
      variant:  product.variant || '',
      design:   product.design || '',
      quantity: qty,
      addedAt:  Date.now(),
    });
  }

  writeCart(cart);
  const summary = buildSummary(cart);
  emit('lilop:cart:item-added', { item: product, ...summary });
  emit('lilop:cart:updated', summary);
}

/**
 * Elimina un item del carrito por su posición en el array.
 * @param {number} index - Índice del item en el carrito
 */
function removeFromCart(index) {
  const cart = readCart();
  const removed = cart.splice(index, 1)[0];
  writeCart(cart);
  const summary = buildSummary(cart);
  emit('lilop:cart:item-removed', { productId: removed?.id, ...summary });
  emit('lilop:cart:updated', summary);
}

/**
 * Actualiza la cantidad de un item.
 * Si la cantidad llega a 0 o menos, elimina el item.
 * @param {number} index    - Índice del item en el carrito
 * @param {number} quantity - Nueva cantidad
 */
function updateQuantity(index, quantity) {
  const cart = readCart();
  if (!cart[index]) return;

  if (quantity <= 0) {
    removeFromCart(index);
    return;
  }

  cart[index].quantity = quantity;
  writeCart(cart);
  const summary = buildSummary(cart);
  emit('lilop:cart:updated', summary);
}

/**
 * Vacía el carrito completamente.
 */
function clearCart() {
  writeCart([]);
  const summary = buildSummary([]);
  emit('lilop:cart:cleared', summary);
  emit('lilop:cart:updated', summary);
}

/* ─── GETTERS ─────────────────────────────────────────────── */

/** Retorna una copia del array del carrito */
function getCart() {
  return readCart();
}

/** Retorna el total de unidades en el carrito */
function getCount() {
  return calcCount(readCart());
}

/** Retorna el precio total del carrito */
function getTotal() {
  return calcTotal(readCart());
}

/** Retorna true si el carrito está vacío */
function isEmpty() {
  return readCart().length === 0;
}

/* ─── FORMATEO ────────────────────────────────────────────── */

/**
 * Formatea un número como precio en pesos colombianos.
 * @param {number} amount
 * @returns {string} ej: "$189.000"
 */
function formatPrice(amount) {
  return '$' + Math.round(amount).toLocaleString('es-CO');
}

/* ─── IMAGEN DE VISUALIZACIÓN (evita duplicados visuales) ──── */
/**
 * Devuelve la imagen a mostrar en tarjetas de producto (catálogo, home, relacionados).
 * Determinística por id de producto: cuando varios productos comparten el mismo
 * pool de diseños, cada uno rota a un índice distinto de forma estable (no cambia
 * entre recargas), evitando que dos productos distintos muestren la misma imagen.
 * @param {object} product - objeto con .id (string) y .images (array)
 * @returns {string} URL de la imagen a mostrar
 */
function getDisplayImage(product) {
  const images = product?.images || [];
  if (!images.length) return '';
  let hash = 0;
  const id = String(product.id || '');
  for (let i = 0; i < id.length; i++) {
    hash = (hash * 31 + id.charCodeAt(i)) >>> 0;
  }
  const idx = hash % images.length;
  return images[idx];
}

/* ─── EXPORTAR API PÚBLICA ────────────────────────────────── */
window.LilopStore = {
  addToCart,
  removeFromCart,
  updateQuantity,
  clearCart,
  getCart,
  getCount,
  getTotal,
  isEmpty,
  formatPrice,
  getDisplayImage,
};