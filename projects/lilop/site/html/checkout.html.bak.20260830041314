<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Completa tu pedido en Lilop de forma rápida y segura con MercadoPago." />
  <title>Pago seguro — Lilop</title>

  <link rel="stylesheet" href="/assets/css/tokens.css?v=aa6d8982" />
  <link rel="stylesheet" href="/assets/css/global.css?v=eadf803e" />
  <link rel="stylesheet" href="/assets/css/components.css?v=65ba54ac" />
  <link rel="stylesheet" href="/assets/css/pages/checkout.css?v=d9261b76" />
</head>
<body>

  <!-- Componentes globales (sin topbar en checkout para menos distracción) -->
  <lilop-navbar></lilop-navbar>
  <lilop-toast></lilop-toast>
  <div class="overlay" id="mainOverlay" aria-hidden="true"></div>

  <!-- ── HEADER CHECKOUT ────────────────────────────────── -->
  <header class="checkout-hero">
    <div class="container">
      <div class="checkout-hero__inner">

        <a href="/index.html" class="checkout-hero__logo" aria-label="Lilop — Ir al inicio">
          Página de pago
        </a>

        <!-- Pasos -->
        <div class="checkout-steps" aria-label="Pasos del proceso de compra" role="list">
          <div class="checkout-step is-done" role="listitem" aria-label="Paso 1: Carrito completado">
            <div class="checkout-step__num" aria-hidden="true">✓</div>
            <span>Carrito</span>
          </div>
          <div class="checkout-step__divider" aria-hidden="true"></div>
          <div class="checkout-step is-active" role="listitem" aria-current="step" aria-label="Paso 2: Datos y pago — paso actual">
            <div class="checkout-step__num" aria-hidden="true">2</div>
            <span>Datos y pago</span>
          </div>
          <div class="checkout-step__divider" aria-hidden="true"></div>
          <div class="checkout-step" role="listitem" aria-label="Paso 3: Confirmación — pendiente">
            <div class="checkout-step__num" aria-hidden="true">3</div>
            <span>Confirmación</span>
          </div>
        </div>

        <a href="/carrito.html" class="checkout-hero__back" aria-label="Volver al carrito">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Volver al carrito
        </a>

      </div>
    </div>
  </header>

  <!-- ── LAYOUT PRINCIPAL ───────────────────────────────── -->
  <div class="container">
    <div class="checkout-layout">

      <!-- FORMULARIO -->
      <div class="checkout-form-section" id="checkoutFormSection">

        <!-- Bloque 1: Datos personales -->
        <div class="checkout-block">
          <div class="checkout-block__header">
            <div class="checkout-block__num" aria-hidden="true">1</div>
            <h2 class="checkout-block__title">Datos de contacto</h2>
          </div>
          <div class="checkout-block__body checkout-fields">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label form-label--required" for="firstName">Nombre</label>
                <input
                  type="text"
                  class="form-input"
                  id="firstName"
                  name="firstName"
                  placeholder="Tu nombre"
                  autocomplete="given-name"
                  required
                  aria-required="true"
                />
              </div>
              <div class="form-group">
                <label class="form-label form-label--required" for="lastName">Apellido</label>
                <input
                  type="text"
                  class="form-input"
                  id="lastName"
                  name="lastName"
                  placeholder="Tu apellido"
                  autocomplete="family-name"
                  required
                  aria-required="true"
                />
              </div>
            </div>
            <div class="form-group">
              <label class="form-label form-label--required" for="email">Correo electrónico</label>
              <input
                type="email"
                class="form-input"
                id="email"
                name="email"
                placeholder="tu@correo.com"
                autocomplete="email"
                required
                aria-required="true"
              />
              <span class="form-hint">Te enviaremos la confirmación a este correo</span>
            </div>
            <div class="form-group">
              <label class="form-label form-label--required" for="phone">Teléfono / WhatsApp</label>
              <input
                type="tel"
                class="form-input"
                id="phone"
                name="phone"
                placeholder="3016006654"
                autocomplete="tel"
                required
                aria-required="true"
              />
              <span class="form-hint">Para coordinar la entrega y enviarte actualizaciones</span>
            </div>
          </div>
        </div>

        <!-- Bloque 2: Dirección de envío -->
        <div class="checkout-block">
          <div class="checkout-block__header">
            <div class="checkout-block__num" aria-hidden="true">2</div>
            <h2 class="checkout-block__title">Dirección de envío</h2>
          </div>
          <div class="checkout-block__body checkout-fields">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label form-label--required" for="city">Ciudad</label>
                <input
                  type="text"
                  class="form-input"
                  id="city"
                  name="city"
                  placeholder="Bogotá"
                  autocomplete="address-level2"
                  required
                  aria-required="true"
                />
              </div>
              <div class="form-group">
                <label class="form-label" for="department">Departamento</label>
                <input
                  type="text"
                  class="form-input"
                  id="department"
                  name="department"
                  placeholder="Cundinamarca"
                  autocomplete="address-level1"
                />
              </div>
            </div>
            <div class="form-group">
              <label class="form-label form-label--required" for="address">Dirección</label>
              <input
                type="text"
                class="form-input"
                id="address"
                name="address"
                placeholder="Calle 123 # 45-67"
                autocomplete="street-address"
                required
                aria-required="true"
              />
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="neighborhood">Barrio</label>
                <input
                  type="text"
                  class="form-input"
                  id="neighborhood"
                  name="neighborhood"
                  placeholder="Chapinero"
                />
              </div>
              <div class="form-group">
                <label class="form-label" for="apartment">Apto / Casa / Oficina</label>
                <input
                  type="text"
                  class="form-input"
                  id="apartment"
                  name="apartment"
                  placeholder="Apto 301"
                  autocomplete="address-line2"
                />
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="orderNotes">Notas para el pedido</label>
              <textarea
                class="form-input"
                id="orderNotes"
                name="orderNotes"
                placeholder="Instrucciones especiales para la entrega (opcional)"
                style="height:80px;resize:none;"
              ></textarea>
            </div>
          </div>
        </div>

        <!-- Bloque 3: Método de pago -->
        <div class="checkout-block">
          <div class="checkout-block__header">
            <div class="checkout-block__num" aria-hidden="true">3</div>
            <h2 class="checkout-block__title">Método de pago</h2>
          </div>
          <div class="checkout-block__body">

            <div class="payment-methods" role="radiogroup" aria-label="Selecciona un método de pago">

              <label class="payment-method is-selected" for="payMercadoPago">
                <input
                  type="radio"
                  id="payMercadoPago"
                  name="paymentMethod"
                  value="mercadopago"
                  checked
                />
                <div class="payment-method__icon" aria-hidden="true" style="background:#009ee3;color:#fff;font-size:9px;font-weight:800;">MP</div>
                <div class="payment-method__info">
                  <p class="payment-method__name">MercadoPago</p>
                  <p class="payment-method__desc">Tarjeta crédito/débito, PSE, Nequi, Daviplata y más</p>
                </div>
              </label>

              <label class="payment-method" for="payTransfer">
                <input
                  type="radio"
                  id="payTransfer"
                  name="paymentMethod"
                  value="transfer"
                />
                <div class="payment-method__icon" aria-hidden="true">🏦</div>
                <div class="payment-method__info">
                  <p class="payment-method__name">Transferencia bancaria</p>
                  <p class="payment-method__desc">Te enviamos los datos por WhatsApp para coordinar</p>
                </div>
              </label>

              <label class="payment-method" for="payWhatsApp">
                <input
                  type="radio"
                  id="payWhatsApp"
                  name="paymentMethod"
                  value="whatsapp"
                />
                <div class="payment-method__icon" aria-hidden="true" style="background:#25d366;color:#fff;font-size:11px;">WA</div>
                <div class="payment-method__info">
                  <p class="payment-method__name">Coordinar por WhatsApp</p>
                  <p class="payment-method__desc">Nos contactas y coordinamos el pago directamente</p>
                </div>
              </label>

            </div>

            <!-- Aviso MercadoPago -->
            <div class="mp-notice" id="mpNotice">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              <p>
                Al confirmar serás redirigido a la plataforma de <strong>MercadoPago</strong>
                para completar el pago de forma segura.
                <strong>⚠️ Integración pendiente:</strong> la conexión con la API de MercadoPago
                requiere un servidor backend con tu Access Token.
                Por ahora el pedido se registra y te contactamos por WhatsApp.
              </p>
            </div>

          </div>
        </div>

        <!-- Botón submit -->
        <div class="checkout-submit">
          <button
            class="checkout-submit__btn"
            id="submitOrderBtn"
            type="button"
            aria-label="Confirmar y pagar"
          >
            <span class="spinner" aria-hidden="true"></span>
            <span class="btn-text" style="display:flex;align-items:center;gap:12px;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              Confirmar pedido
            </span>
          </button>
          <p class="checkout-submit__note">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            Tus datos están protegidos con cifrado SSL
          </p>
        </div>

      </div>

      <!-- RESUMEN LATERAL -->
      <aside class="checkout-summary" id="checkoutSummary" aria-label="Resumen de tu pedido">

        <div class="checkout-summary__header">
          <h2 class="checkout-summary__title">Tu pedido</h2>
          <a href="/carrito.html" class="checkout-summary__toggle" aria-label="Editar carrito">
            Editar
          </a>
        </div>

        <!-- Items inyectados por pago.js -->
        <div class="checkout-summary__items" id="summaryItems" aria-label="Productos en el pedido">
        </div>

        <!-- Totales -->
        <div class="checkout-summary__totals">
          <div class="checkout-summary__row">
            <span id="summaryItemsLabel">Productos</span>
            <span id="summarySubtotal"></span>
          </div>
          <div class="checkout-summary__row">
            <span>Envío</span>
            <span id="summaryShipping">Por calcular</span>
          </div>
          <div class="checkout-summary__row checkout-summary__row--total">
            <span>Total</span>
            <span class="checkout-summary__total-num" id="summaryTotal"></span>
          </div>
        </div>

        <!-- Trust -->
        <div class="checkout-summary__footer">
          <div class="checkout-summary__trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            Pago 100% seguro
          </div>
          <div class="checkout-summary__trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round"/>
            </svg>
            Envío gratis desde $200.000
          </div>
          <div class="checkout-summary__trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="1 4 1 10 7 10"/>
              <path d="M3.51 15a9 9 0 1 0 .49-3.51"/>
            </svg>
            Devoluciones sin complicaciones
          </div>
        </div>

      </aside>

    </div>
  </div>

  <!-- Footer -->
  <lilop-footer></lilop-footer>

  <!-- Scripts -->
  <script src="/assets/js/store.js?v=0a53486f"></script>
  <script src="/assets/js/router.js?v=8d0bfb43"></script>
  <script src="/assets/js/components/navbar.js?v=5d67e0cc"></script>
  <script src="/assets/js/components/footer.js?v=8f5f53e5"></script>
  <script src="/assets/js/components/toast.js?v=ca49ca94"></script>
  <script src="/assets/js/pages/checkout.js?v=40b2d230"></script>

</body>
</html>